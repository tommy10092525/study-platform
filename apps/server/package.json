{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --minify",
    "check-types": "tsc --noEmit",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply study-platform-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply study-platform-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260904.1",
    "@repo/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
